# порт приложения
PORT = 3000

# URL для подключения к БД
DATABASE_URL = "postgresql://{user}:{password}@localhost:5432/{db}"

# секретный строки (используйте символы и цифры)
JWT_ACCESS_SECRET = придумайте_или_сгенерируйте_секретную_строку_для_access_токена
JWT_REFRESH_SECRET = придумайте_или_сгенерируйте_секретную_строку_для_refresh_токена

# продолжительность жизни ваших токенов
JWT_ACCESS_TTL = 900 # 15 минут    
JWT_REFRESH_TTL = 604800 # 7 дней

# переменные среды PostgreSQL
POSTGRES_USER = your_user
POSTGRES_PASSWORD = your_password
POSTGRES_DB = your_db_name
